{
  "expo": {
    "name": "Santa's Naughty or Nice List",
    "slug": "SantaListApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#28563C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.sean.santalist",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#28563C",
          "imageWidth": 240
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "0abd0ad9-9767-42c7-9504-7ccbfbc0d027"
      }
    }
  }
}
